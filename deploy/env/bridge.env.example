NODE_ENV=production

# Exact VPC address of the KMS Droplet. Never use 0.0.0.0.
KMS_BRIDGE_HOST=__KMS_PRIVATE_IP__
KMS_BRIDGE_PORT=9445

KMS_BRIDGE_TLS_CERT_PATH=/etc/kalqix-kms/tls/bridge.crt
KMS_BRIDGE_TLS_KEY_PATH=/etc/kalqix-kms/tls/bridge.key

# OpenBao stays loopback-only on the same Droplet.
KMS_BRIDGE_OPENBAO_URL=https://127.0.0.1:8200
KMS_BRIDGE_OPENBAO_MOUNT=kalqix-transit

KMS_BRIDGE_REQUEST_TIMEOUT_MS=5000
KMS_BRIDGE_BODY_LIMIT_BYTES=8192
KMS_BRIDGE_MAX_INFLIGHT=16

# Secrets are loaded through systemd LoadCredential, never from this file:
#   service-token
#   openbao-role-id
#   openbao-secret-id
