# Replace __KMS_PRIVATE_IP__ before installation. OpenBao's client API remains
# loopback-only; the bridge is the sole network-facing KMS contract.
ui                  = false
disable_mlock       = false
log_level           = "info"
log_format          = "json"
api_addr            = "https://127.0.0.1:8200"
cluster_addr        = "https://__KMS_PRIVATE_IP__:8201"
default_lease_ttl   = "15m"
max_lease_ttl       = "1h"
raw_storage_endpoint = false

storage "raft" {
  path    = "/var/lib/openbao/raft"
  node_id = "kalqix-kms-fra1-1"
}

listener "tcp" {
  address            = "127.0.0.1:8200"
  cluster_address    = "__KMS_PRIVATE_IP__:8201"
  tls_cert_file      = "/etc/openbao/tls/openbao.crt"
  tls_key_file       = "/etc/openbao/tls/openbao.key"
  tls_client_ca_file = "/etc/openbao/tls/ca.crt"
  tls_min_version    = "tls13"
  tls_disable        = false
}

telemetry {
  disable_hostname = true
}
